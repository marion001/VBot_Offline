[Unit]
Description=VBot Assistant – Keep I2S DAC awake to prevent pop noise
After=sound.target

[Service]
Type=simple
ExecStart=/usr/bin/aplay -q -D dmixer -t raw -r 48000 -f S32_LE -c 2 --period-size=2048 --buffer-size=8192 /dev/zero
Restart=always
RestartSec=1
Nice=0

[Install]
WantedBy=multi-user.target
